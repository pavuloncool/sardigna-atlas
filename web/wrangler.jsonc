{
  // Wariant „Workers static assets” (przenośność z Pages). Cloudflare Pages ignoruje ten plik,
  // dopóki nie ma w nim `pages_build_output_dir`; w Pages obowiązują ustawienia projektu.
  // Wdrożenie tego wariantu: `pnpm dlx wrangler@latest deploy` w folderze web (po `pnpm build`).
  "$schema": "https://workers.cloudflare.com/wrangler-config-schema.json",
  "name": "sardigna-atlas",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
