{
  // Wariant „Workers static assets” (przenośność z Pages), NIE do użycia w Pages.
  // Plik celowo NIE nazywa się `wrangler.jsonc`: sprawdzone na podglądzie gałęzi, że wykryty
  // `wrangler.jsonc` w katalogu projektu wyłącza funkcje Pages (`/api/contact` przestaje działać).
  // Wdrożenie tego wariantu (z folderu web, po `pnpm build`):
  //   pnpm dlx wrangler@latest deploy -c wrangler.workers.jsonc
  "$schema": "https://workers.cloudflare.com/wrangler-config-schema.json",
  "name": "sardigna-atlas",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
