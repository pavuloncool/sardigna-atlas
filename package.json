{
  "name": "sardigna-atlas",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "studio": "pnpm --filter sardigna-atlas-studio dev",
    "typecheck": "pnpm -r typecheck && tsc -p scripts",
    "lint": "pnpm -r lint",
    "build": "pnpm --filter web build",
    "seed:build": "tsx scripts/seed/build.ts",
    "seed:import": "pnpm seed:build && pnpm --filter sardigna-atlas-studio exec sanity datasets import --replace -d production \"$PWD/scripts/seed/out/seed.ndjson\"",
    "verify:queries": "tsx scripts/verify-queries.ts",
    "verify:live": "tsx scripts/verify-live.ts"
  },
  "devDependencies": {
    "@sanity/client": "^8.9.0",
    "@types/node": "^22.20.5",
    "groq": "^6.17.0",
    "groq-js": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
